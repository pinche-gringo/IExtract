msgstr ""

#: src/IExtract.cpp:355
msgid "-warning: Invalid number of threads!\n"
msgstr ""

#: src/IExtract.cpp:397
#, ycp-format
msgid ""
"-warning: Argument for new files `%1' is not valid! Ignoring option `n'\n"
msgstr ""

#: src/IExtract.cpp:443
#, ycp-format
msgid "-warning: Ignoring invalid option `%1'\n"
msgstr ""

#: src/IExtract.cpp:537 src/IExtract.cpp:661
msgid "-error: "
msgstr ""

#: src/IExtract.cpp:548
msgid "Unknown file-type"
msgstr ""

