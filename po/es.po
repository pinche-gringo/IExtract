#: src/IExtract.cpp:279
msgid ""
"Extracts a description out of files (depending on the file-type)\n"
"\n"
"Usage:"
msgstr ""
"Extrae la descripción desde archivos (dependende del tipo del archivo)\n"
"\n"
"Modo de empleo:"

#: src/IExtract.cpp:280
msgid "[OPTIONS] <File(s)>"
msgstr "[OPCIONES| <Archivo(s)>"

#: src/IExtract.cpp:281
msgid "Recurse into subdirectories"
msgstr "Busca también en carpetas bajos"

#: src/IExtract.cpp:282
msgid "Sets the output-style (text, HTML XML or LaTeX)"
msgstr "Especifa el estilo de la salida (text, HTML, XML o LaTeX)"

#: src/IExtract.cpp:283
msgid "Format of output; default: "
msgstr "Formato de la salida; por defecto: "

#: src/IExtract.cpp:284
msgid "Title of output"
msgstr "Título de la salida"

#: src/IExtract.cpp:285
msgid ""
"Separate subdirectories with TEXT (default: empty);\n"
"\t\t\t  implies recursion into subdirectories (--recursive)"
msgstr ""
"Separa carpetas bajos con TEXT (por defecto: vacio);\n"
"                          implica recursión en carpetas (--recursive)"

#: src/IExtract.cpp:286
msgid "Text to print before any output"
msgstr "Texto para escribir antes de cualquiera salida"

#: src/IExtract.cpp:287
msgid "File to print before any output"
msgstr "Archivo para escribir antes de cualquiera salida"

#: src/IExtract.cpp:288
msgid "Text to print at the end of the output"
msgstr "Texto para escribir después de cualquiera salida<"

#: src/IExtract.cpp:289
msgid "File to print at the end of the output"
msgstr "Archivo para escribir después de cualquiera salida<"

#: src/IExtract.cpp:290
msgid "Puts error messages (additionally) into the output"
msgstr "Pone también el mensaje del error en la salida"

#: src/IExtract.cpp:291
msgid "Show all files (including unknown types) in output"
msgstr "Mostra todos los archivos (también tipos inconocidos)"

#: src/IExtract.cpp:293
msgid "Number of threads for examining files (default: 1)"
msgstr "Número de procesos del fondo (threads) adicional (por defecto: 1)"

#: src/IExtract.cpp:295
msgid "Show TEXT for files younger than DAYS days (def: 30)"
msgstr ""
"Mostra TEXT por archivos más joven que DAYS (por\n"
"                          defecto: 30)"

#: src/IExtract.cpp:296
msgid "Files to inspect"
msgstr "Ficheros para inspectar"

#: src/IExtract.cpp:297
msgid "Files not to inspect"
msgstr "Ficheros para no inspectar"

#: src/IExtract.cpp:298
msgid "Read further options from specified file"
msgstr "Lee más opciones desde el archivo especificado"

#: src/IExtract.cpp:299
msgid "Sort found files alphabetically"
msgstr "Sortea los archivos alfabeticalmente"

#: src/IExtract.cpp:300
msgid "Ignore last extension (if unknown)"
msgstr "Ignora la última extensión (si está desconocida)"

#: src/IExtract.cpp:301
msgid "Output version information and exit"
msgstr "Informa de la versión y finaliza"

#: src/IExtract.cpp:302
msgid "Displays this help and exit\n"
msgstr "Muestra este texto de ayuda y finaliza\n"

#: src/IExtract.cpp:303
msgid ""
"  File(s) ... Files to analyze (the last part can contain wildcards)\n"
"\n"
msgstr ""
"  Archivo(s) ... Archivos por inspectar (el último parte puede contener\n"
"                 fijadores de posiciones)\n"
"\n"

#: src/IExtract.cpp:304
msgid ""
"DAYS (in option -n) may be omited or may have an multiplier suffix: m for "
"30.\n"
"\n"
msgstr ""
"DAYS puede hacer falta o tener un apéndice de multiplicación: m por 30.\n"
"\n"

#: src/IExtract.cpp:305
msgid ""
"LIST is a list of files; seperated with the path-separator of the operating\n"
msgstr ""
"LIST es una lista de archivos; separada por la la letra seperado del camino "
"del\n"

#: src/IExtract.cpp:306
msgid ""
"     system (':' for UNICES, ';' for Windows). E.g. *.html:*.doc\n"
"\n"
msgstr ""
"     sistema operativo (dos puntos (:) en Unices; punto y coma (;) en "
"Windows).\n"
"     P.e.: *.html:*.doc\n"
"\n"

#: src/IExtract.cpp:307
msgid "FORMAT specifies how to print the entries;\n"
msgstr "FORMAT especifica el formato de la salida;\n"

#: src/IExtract.cpp:308
msgid "       The pipe symbol (|) separates columns\n"
msgstr "       La raya vertical (|) separa los columnas\n"

#: src/IExtract.cpp:309
#, c-format
msgid "       %a is substituted with the author\n"
msgstr "       %a está cambiado por el autor\n"

#: src/IExtract.cpp:310
#, c-format
msgid "       %c is substituted with the comment\n"
msgstr "       %c está cambiado por el comentario\n"

#: src/IExtract.cpp:311
#, c-format
msgid "       %d is substituted with the modification time of the file\n"
msgstr ""
"       %d está cambiado por la fecha y la hora del último cambio del "
"archivo\n"

#: src/IExtract.cpp:312
msgid ""
"       %D is substituted with the modification time of the file (day only)\n"
msgstr "       %D está cambiado por la fecha del último cambio del archivo\n"

#: src/IExtract.cpp:313
#, c-format
msgid "       %e is substituted with the extension of the file\n"
msgstr "       %e está cambiado por la extensión del archivo\n"

#: src/IExtract.cpp:314
#, c-format
msgid "       %E is substituted with the name of the file without extension\n"
msgstr "       %E está cambiado por el nombre del archivo sin extensión\n"

#: src/IExtract.cpp:315
#, c-format
msgid "       %n is substituted with the name of the file\n"
msgstr "       %n está cambiado por el nombre del archivo\n"

#: src/IExtract.cpp:316
msgid "       %N is substituted with path and name of the file\n"
msgstr "       %N está cambiado por nombre y camino del archivo\n"

#: src/IExtract.cpp:317
#, c-format
msgid "       %p is substituted with the path of the file\n"
msgstr "       %p está cambiado por el camino del archivo\n"

#: src/IExtract.cpp:318
msgid ""
"       %P is substituted with the path of the file in UNIX style (with /)\n"
msgstr ""
"       %p está cambiado por el camino del archivo en estilo UNIX (separado "
"con\n"
"          un slash (/))\n"

#: src/IExtract.cpp:319
#, c-format
msgid "       %s is substituted with the size of the file\n"
msgstr "       %s está cambiado por el tamaño del archivo\n"

#: src/IExtract.cpp:320
#, c-format
msgid "       %S is substituted with the size of the file (human readable)\n"
msgstr ""
"       %S está cambiado por el tamaño del archivo en estilo para seres "
"humanos\n"

#: src/IExtract.cpp:321
msgid "       %t is substituted with the title\n"
msgstr "       %t está cambiado por el título\n"

#: src/IExtract.cpp:322
msgid ""
"       %U is substituted with path and name of the file in UNIX style "
"(with /)\n"
msgstr ""
"       %U está cambiado por nombre y camino del archivo en estilo UNIX "
"(separado\n"
"          con un slash (/))\n"

#: src/IExtract.cpp:323
msgid ""
"       %(LETTERS) is substituted with first of the above substitutions\n"
"          producing a non-empty string (e.g. %(tn) is the titel if not \n"
"          empty or else the filename.)\n"
msgstr ""
"       %(LETRAS) está cambiado por el primer cambio (de las reglas "
"anteriores)\n"
"         que produce un text no vacio (p.e. %(tn) será el titulo (si hay) o "
"el\n"
"         nombre del archivo)\n"

#: src/IExtract.cpp:326
#, no-c-format
msgid ""
"       %*LETTER changes the substitution slightly. For file names it causes "
"a\n"
"          conversion of special characters; for the others it suppresses "
"them\n"
"\n"
msgstr ""
"       %*LETRA cambia la significancia de LETRA un poco. Para nombres de\n"
"         archivo pasa adicional una converción le letras especiales; para "
"los\n"
"         demas se suprime ese converción\n"

#: src/IExtract.cpp:328
#, no-c-format
msgid ""
"       In every other constellation the '%' is removed!\n"
"\n"
msgstr ""
"       ¡En todas las demás formas el '%' está borrado!\n"
"\n"

#: src/IExtract.cpp:329
msgid ""
"TITLE specifies the headers for the output; separated with (|); columns "
"must\n"
msgstr ""
"TITLE especifica la cabeza por la salida; separada por la raya vertical "
"(|);\n"

#: src/IExtract.cpp:330
msgid ""
"      contain at least one character\n"
"\n"
msgstr ""
"      ¡cada columna tiene que contener al menos una letra!\n"
"\n"

#: src/IExtract.cpp:331
msgid ""
"TEXT specifies the text to separate subdirectories; with the following\n"
msgstr ""
"TEXT especifica el texto por separar carpetas bajas; el signo del perciento "
"(%)\n"

#: src/IExtract.cpp:332
msgid "     conversion strings:\n"
msgstr "     indica que la letra siguente tiene significada especial:\n"

#: src/IExtract.cpp:333
#, c-format
msgid "       %e prints the end-of-output for the specified output style\n"
msgstr "       %e imprima el fin-de-la-salida por el estilo especificado\n"

#: src/IExtract.cpp:334
#, c-format
msgid "       %n is substituted with the name of the directory\n"
msgstr "       %n está cambiado por el nombre del la carpeta\n"

#: src/IExtract.cpp:335
msgid "       %N is substituted with the full path of the directory\n"
msgstr "       %N está cambiado por el nombre y el camino de la carpeta\n"

#: src/IExtract.cpp:336
#, c-format
msgid "       %p is substituted with the path to the directory\n"
msgstr "       %p está cambiado por el camino hasta la carpeta\n"

#: src/IExtract.cpp:337
msgid ""
"       %P is substituted with the path to the directory in UNIX style "
"(with /)\n"
msgstr ""
"       %P está cambiado por el camino hasta la carpeta en estilo UNIX "
"(separado\n"
"          por un slash (/)).\n"

#: src/IExtract.cpp:338
#, c-format
msgid "       %s prints the start-of-output for the specified output style\n"
msgstr "       %s imprima la empieza-de-la-salida por el estilo especifado\n"

#: src/IExtract.cpp:339
msgid ""
"       %U is substituted with the full path of the dir in UNIX style "
"(with /)\n"
"\n"
msgstr ""
"       %U está cambiado por el nombre y el camino de la carpeta en estilo "
"UNIX\n"
"          (separado por un slash (/))\n"

#: src/IExtract.cpp:340
msgid ""
"     As with FORMAT, the pipe symbol (|) separates columns.\n"
"\n"
msgstr ""
"     Como con FORMAT, la raya vertical (|) separa a los columnas.\n"
"\n"

#: src/IExtract.cpp:341
msgid ""
"The format of the INI file is like this (entries can be missing):\n"
"\n"
msgstr ""
"Archivos por initializar tienen el siguente formato (entradas pueden "
"faltar):\n"
"\n"

