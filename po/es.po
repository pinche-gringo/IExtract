msgid "Unknown file-type"
msgstr "Tipo del archivo inconocido"

#: src/IExtract.cpp:772
msgid ""
"-error: File `%1' can't be opened!\n"
"Reason: "
msgstr ""
"-error: ¡No se puede abrir archivo '%1'!\n"
"Causa: "

#: src/IExtract.cpp:793
msgid "Error while processing: "
msgstr "Error procesando: "

#: src/IExtract.cpp:947
msgid ""
"-warning: The INI-file `%1' contains an invalid entry for the output style (`"
"%2')! Using text\n"
msgstr ""
"-avios: ¡El archivo por iniciar '%1' contiene una entrada invalida por el "
"estilo de la salida ('%2')! Uso text\n"

