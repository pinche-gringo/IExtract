msgstr "-aviso: ¡Estilo de la salida '%1' no es válido! Uso text\n"

#: src/IExtract.cpp:513
msgid "-warning: Invalid number of threads!\n"
msgstr "-aviso: ¡El número de los proceses del fondo (threads) no es válido!\n"

#: src/IExtract.cpp:557
msgid ""
"-warning: Argument for new files `%1' is not valid! Ignoring option `n'\n"
