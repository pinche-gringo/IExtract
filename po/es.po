msgstr "-aviso: ¡Opción '%1' necesita un argumento! ¡Ignoro opción!\n"

#: src/IExtract.cpp:499
msgid "-warning: Style of output `%1' is not valid! Using text\n"
msgstr "-aviso: ¡Estilo de la salida '%1' no es válido! Uso text\n"

#: src/IExtract.cpp:513
msgid "-warning: Invalid number of threads!\n"
msgstr "-aviso: ¡El número de los proceses del fondo (threads) no es válido!\n"

#: src/IExtract.cpp:557
msgid ""
"-warning: Argument for new files `%1' is not valid! Ignoring option `n'\n"
msgstr ""
"-aviso: ¡Argumento por archivos nuevos '%1' no es válido! Ignoro opción 'n'\n"

#: src/IExtract.cpp:623
msgid "-error: `%1' is not a (readable) file! Ignoring option `%2'!\n"
msgstr "-error: ¡No puedo leer archivo '%1'! ¡Ignoro opción '%2'!\n"

#: src/IExtract.cpp:654
msgid "-warning: Invalid mode `%1'! Ignoring option 'M'!\n"
msgstr "-aviso: ¡Modo '%1' inválido! ¡Ignoro opción 'M'!\n"

#: src/IExtract.cpp:668
msgid "-warning: Ignoring invalid option `%1'\n"
msgstr "-aviso: Ignoro opción inválida '%1'\n"

#: src/IExtract.cpp:860 src/IExtract.cpp:984
msgid "-error: "
msgstr ""

#: src/IExtract.cpp:871
msgid "Unknown file-type"
msgstr "Tipo del archivo desconocido"

#: src/IExtract.cpp:965
msgid ""
"-error: File `%1' can't be opened!\n"
"Reason: "
msgstr ""
"-error: ¡No se puede abrir el archivo '%1'!\n"
"Causa: "

#: src/IExtract.cpp:987
msgid "Error while processing: "
msgstr "Error procesando: "

#: src/IExtract.cpp:1228
msgid ""
"-warning: The INI-file `%1' contains an invalid entry for the output style (`"
"%2')! Using text\n"
msgstr ""
"-aviso: ¡El archivo por iniciar '%1' contiene una entrada inválida por el "
"estilo de la salida ('%2')! Uso text\n"

#: src/IExtract.cpp:1237
msgid ""
"-warning: The INI-file `%1' contains an invalid mode to determine the file-"
"type (`%2')! Using text\n"
msgstr ""
"-aviso: ¡El archivo por iniciar '%1' contiene una entrada inválida por el "
"estilo de la salida ('%2')! Uso text\n"

