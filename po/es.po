msgstr "-aviso: ¡El número de los proceses del fondo (threads) no es valido!\n"

#: src/IExtract.cpp:451
msgid ""
"-warning: Argument for new files `%1' is not valid! Ignoring option `n'\n"
msgstr ""
"-aviso: ¡Argumento por archivos nuevos '%1' no es valido! Ignoro opción 'n'\n"

#: src/IExtract.cpp:516
msgid "-error: `%1' is not a (readable) file! Ignoring option `%2'!\n"
msgstr "-error: ¡No puedo leer archivo '%1'! ¡Ignoro opción '%2'!\n"

#: src/IExtract.cpp:548
msgid "-warning: Ignoring invalid option `%1'\n"
msgstr "-aviso: Ignoro opción invalida '%1'\n"

#: src/IExtract.cpp:665 src/IExtract.cpp:791
msgid "-error: "
msgstr ""

