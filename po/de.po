msgid "-warning: Invalid mode `%1'! Ignoring option 'M'!\n"
msgstr "-Warnung: Ungültiger Modus \"%1\"! Ignoriere Option 'M'!\n"

#: src/IExtract.cpp:707
msgid "-warning: Ignoring invalid option `%1'\n"
msgstr "-Warnung: Ignoriere unbekannte Option \"%1\"\n"

