#: src/IExtract.cpp:242
msgid ""
"Extracts a description out of files (depending on the file-type)\n"
"\n"
"Usage:"
msgstr ""
"Liest die Beschreibung aus verschiedenen Dateien (abhängig vom Filetyp)\n"
"\n"
"Aufruf:"

#: src/IExtract.cpp:243
msgid "[OPTIONS] <File(s)>"
msgstr "[OPTIONEN] <Datei(en)>"

#: src/IExtract.cpp:244
msgid "Recurse into subdirectories"
msgstr "Rekursiver Vergleich von Unterverzeichnissen"

#: src/IExtract.cpp:245
msgid "Sets the output-style (text, HTML or LaTeX)"
msgstr "Setzt den Ausgabestil (text, HTML oder LaTeX)"

#: src/IExtract.cpp:246
msgid "Format of output; default: "
msgstr "Format der Ausgabe; Default: "

#: src/IExtract.cpp:247
msgid "Title of output"
msgstr "Titel der Ausgabe"

#: src/IExtract.cpp:248
msgid ""
"Separate subdirectories with TEXT (default: empty);\n"
"implies recursion into subdirectories (--recursive)"
msgstr ""
"Trenne Unterverzeichnisse mit TEXT (Default: Leer);\n"
"                           Impliziert Rekursion in Unterverzeichnisse\n"
"                           (Option --recursive)"

#: src/IExtract.cpp:249
msgid "Puts error messages (additionally) into the output"
msgstr "Schreibt (zusätzlich) Fehlermeldungen in die Ausgabe"

#: src/IExtract.cpp:250
msgid "Show all files (including unknown types) in output"
msgstr "Zeige alle Dateien (auch unbekannte Typen) in Ausgabe"

#: src/IExtract.cpp:252
msgid "Number of threads for examining files (default: 1)"
msgstr ""
"Nummer der Hintergrundprozesse (Threads) zur Untersuchung der\n"
"Dateien (Default: 1)"

#: src/IExtract.cpp:254
msgid "Show TEXT for files younger than DAYS days (def: 30)"
msgstr "Zeige TEXT für Dateien jünger als DAYS Tage (Def: 30)"

#: src/IExtract.cpp:255
msgid "Files to inspect"
msgstr "Spezifiziert die zu untersuchenden Dateien"

#: src/IExtract.cpp:256
msgid "Files not to inspect"
msgstr "Spezifiziert die nicht zu untersuchenden Dateien"

#: src/IExtract.cpp:257
msgid "Read further options from specified file"
msgstr "Lies weitere Optionen aus der angegebenen Datei"

#: src/IExtract.cpp:258
msgid "Output version information and exit"
msgstr "Ausgabe der Versionsinformation und beenden"

#: src/IExtract.cpp:259
msgid "Displays this help and exit\n"
msgstr "Ausgabe dieser Hilfe und beenden\n"

#: src/IExtract.cpp:260
msgid ""
"  File(s) ... Files to analyze (the last part can contain wildcards)\n"
"\n"
msgstr ""
"  Datei(en) ... Zu untersuchende Dateien (der letzte Teil kann Platzhalter\n"
"                enthalten\n"
"\n"

#: src/IExtract.cpp:261
msgid ""
"DAYS (in option -n) may be omited or may have an multiplier suffix: m for "
"30.\n"
"\n"
msgstr ""
"DAYS kann fehlen oder einen Multiplikator als Anhang haben: m für 30.\n"
"\n"

#: src/IExtract.cpp:262
msgid ""
"LIST is a list of files; seperated with the path-separator of the operating\n"
msgstr ""
"LIST ist eine Liste von Dateien; getrennt mit dem Pfad-Separator des "
"Betriebs-\n"

#: src/IExtract.cpp:263
msgid ""
"     system (':' for UNICES, ';' for Windows). E.g. *.html:*.doc\n"
"\n"
msgstr ""
"     systems (der Doppelpunkt (:) für UNIX, der Strichpunkt (;) für "
"Windows).\n"
"     Z.B.: [^iI]*.html:*.doc\n"
"\n"

#: src/IExtract.cpp:264
msgid "FORMAT specifies how to print the entries;\n"
msgstr "FORMAT specifieziert, wie die Einträge geschrieben werden sollen:\n"

#: src/IExtract.cpp:265
msgid "       %a is substituted with the author\n"
msgstr "       %a wird mit dem Autor ersetzt\n"

#: src/IExtract.cpp:266
#, c-format
msgid "       %c is substituted with the comment\n"
msgstr "       %c wird mit dem Kommentar ersetzt\n"

#: src/IExtract.cpp:267
#, c-format
msgid "       %d is substituted with the modification time of the file\n"
msgstr "       %d wird mit dem Datum der letzten Änderung der Datei ersetzt\n"

#: src/IExtract.cpp:268
msgid ""
"       %D is substituted with the modification time of the file (day only)\n"
msgstr "       %d wird mit dem Tag der letzten Änderung der Datei ersetzt\n"

#: src/IExtract.cpp:269
#, c-format
msgid "       %n is substituted with the name of the file\n"
msgstr "       %n wird mit dem Namen der Datei ersetzt\n"

#: src/IExtract.cpp:270
msgid "       %N is substituted with path and name of the file\n"
msgstr "       %N wird mit dem Pfad und dem Namen der Datei ersetzt\n"

#: src/IExtract.cpp:271
#, c-format
msgid "       %p is substituted with the path of the file\n"
msgstr "       %p wird mit dem Pfad der Datei ersetzt\n"

#: src/IExtract.cpp:272
msgid ""
"       %P is substituted with the path of the file in UNIX style (with /)\n"
msgstr ""
"       %P wird mit dem Pfad der Datei im UNIX-Stil (Verzeichnisse getrennt "
"mit\n"
"          einem Schrägstrich (/)) ersetzt\n"

#: src/IExtract.cpp:273
#, c-format
msgid "       %s is substituted with the size of the file\n"
msgstr "       %s wird mit der Dateigröße ersetzt\n"

#: src/IExtract.cpp:274
msgid "       %S is substituted with the size of the file (human readable)\n"
msgstr ""
"       %S wird mit der Dateigröße (in einem für den Menschen lesbaren "
"Format)\n"
"          ersetzt\n"

#: src/IExtract.cpp:275
msgid "       %t is substituted with the title\n"
msgstr "       %t wird mit dem gefundenen Titel ersetzt\n"

#: src/IExtract.cpp:276
msgid ""
"       %U is substituted with path and name of the file in UNIX style "
"(with /)\n"
msgstr ""
"       %U wird mit dem Pfad und dem Namen der Datei im UNIX-Stil "
"(Verzeichnisse\n"
"          getrennt mit einem Schrägstrich (/)) ersetzt\n"

#: src/IExtract.cpp:277
msgid ""
"       %(LETTERS) is substituted with first of the above substitutions\n"
msgstr ""
"       %(LETTERS) wird mit der ersten der obigen Ersetzungen ersetzt, die "
"einen\n"

#: src/IExtract.cpp:278
msgid ""
"          producing a non-empty string (e.g. %(tn) is the titel if not \n"
msgstr ""
"          nicht-leeren String ergibt (z.B.: %(tn) ist der Titel, wenn vor-\n"

#: src/IExtract.cpp:279
msgid ""
"          empty or else the filename.)\n"
"\n"
msgstr ""
"          handen, sonst der Dateiname)\n"
"\n"

#: src/IExtract.cpp:280
#, c-format
msgid ""
"       In every other constellation the '%' is removed!\n"
"\n"
msgstr ""
"          In jeder anderen Zusammensetzung wird das Prozent lediglich "
"entfernt!\n"
"\n"

#: src/IExtract.cpp:281
msgid ""
"TITLE specifies the headers for the output; separated with (|); columns "
"must\n"
msgstr ""
"TITLE spezifiziert den Kopf der Ausgabe; die Spalten werden mit dem "
"Schrägstrich\n"

#: src/IExtract.cpp:282
msgid ""
"      contain at least one character\n"
"\n"
msgstr ""
"      getrennt; jede Spalte muß zumindest ein Zeichen aufweisen\n"
"\n"

#: src/IExtract.cpp:283
msgid ""
"TEXT specifies the text to separate subdirectories; with the following\n"
msgstr ""
"TEXT spezifiziert den Text, der die einzelnen Unterverzeichnisse trennt; "
"die\n"

#: src/IExtract.cpp:284
msgid "     conversion strings:\n"
msgstr "     folgenden Platzhalter werden unterstützt:\n"

#: src/IExtract.cpp:285
#, c-format
msgid "       %e prints the end-of-output for the specified output style\n"
msgstr ""
"       %e wird mit dem Ende-der-Ausgabe (des jeweiligen Stils) ersetzt\n"

#: src/IExtract.cpp:286
#, c-format
msgid "       %n is substituted with the name of the directory\n"
msgstr "       %n wird mit dem Namen des Verzeichnisses ersetzt\n"

#: src/IExtract.cpp:287
msgid "       %N is substituted with the full path of the directory\n"
msgstr "       %N wird mit dem Pfad zum und Namen des Verzeichnisses ersetzt\n"

#: src/IExtract.cpp:288
#, c-format
msgid "       %p is substituted with the path to the directory\n"
msgstr "       %p wird mit dem Pfad zum Verzeichnis ersetzt\n"

#: src/IExtract.cpp:289
msgid ""
"       %P is substituted with the path to the directory in UNIX style "
"(with /)\n"
msgstr ""
"       %P wird mit dem Pfad zum Verzeichnis im UNIX-Stil (Verzeichnisse "
"getrennt\n"
"          mit einem Schrägstrich (/)) ersetzt\n"

#: src/IExtract.cpp:290
#, c-format
msgid "       %s prints the start-of-output for the specified output style\n"
msgstr ""
"        %s wird mit dem Start-der-Ausgabe (des jeweiligen Stils) ersetzt\n"

#: src/IExtract.cpp:291
msgid ""
"       %U is substituted with the full path of the dir in UNIX style "
"(with /)\n"
"\n"
msgstr ""
"       %U wird mit dem Pfad zum und Names des Verzeichnissses im UNIX-Stil\n"
"          (Verzeichnisse getrennt mit einem Schrägstrich (/)) ersetzt\n"

#: src/IExtract.cpp:292
msgid ""
"The format of the INI file is like this (entries can be missing):\n"
"\n"
msgstr ""
"INI-Files haben folgendes Format (Einträge können fehlen):\n"
"\n"

#: src/IExtract.cpp:300
msgid "Currently supported files are:"
msgstr "Unterstützte Dateientypen sind:"

#: src/IExtract.cpp:324 src/IExtract.cpp:367 src/IExtract.cpp:378
#: src/IExtract.cpp:415 src/IExtract.cpp:428
#, ycp-format
msgid "-warning: Option `%1' needs an argument! Ignoring option!\n"
msgstr "-Warnung: Option \"%1\" benötigt ein Argument! Ignoriere Option!\n"

#: src/IExtract.cpp:339
#, ycp-format
msgid "-warning: Style of output `%1' is not valid! Using text\n"
msgstr "-Warning: \"%1\" ist kein gültiger Ausgabestil! Verwende text\n"

#: src/IExtract.cpp:353
msgid "-warning: Invalid number of threads!\n"
msgstr "-Warnung: Ungültige Anzahl von Threads (Hintergrundprozessen)!\n"

#: src/IExtract.cpp:391
#, ycp-format
msgid ""
"-warning: Argument for new files `%1' is not valid! Ignoring option `n'\n"
msgstr ""
"-Warnung: \"%1\" ist kein gültiges Argument für neue Datein!\n"
"Ignoriere Option \"n\"\n"

#: src/IExtract.cpp:437
#, ycp-format
msgid "-warning: Ignoring invalid option `%1'\n"
msgstr "-Warnung: Ignoriere unbekannte Option \"%1\"\n"

#: src/IExtract.cpp:531 src/IExtract.cpp:655
msgid "-error: "
msgstr "-Fehler: "

#: src/IExtract.cpp:542
msgid "Unknown file-type"
msgstr "Unbekannter Dateityp"

#: src/IExtract.cpp:636
#, ycp-format
msgid ""
"-error: File `%1' can't be opened!\n"
"Reason: "
msgstr ""
"Datei \"%1\" kann nicht geöffnet werden!\n"
"Ursache: "

#: src/IExtract.cpp:657
msgid "Error while processing: "
msgstr "Error beim Bearbeiten: "

#: src/IExtract.cpp:791
#, ycp-format
msgid ""
"-warning: The INI-file `%1' contains an invalid entry for the output style (`"
"%2')! Using text\n"
msgstr "-Warnung: Das INI-File \"%1\" enthält einen ungültigen Eintrag für den Ausgabestil (\"%2\")! Verwende text\n"

