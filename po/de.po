#: src/IExtract.cpp:1241
msgid ""
"-warning: The INI-file `%1' contains an invalid mode to determine the file-"
"type (`%2')! Using text\n"
msgstr ""
"-Warnung: Das INI-File \"%1\" enthält einen ungültigen Eintrag für den "
"Ausgabestil (\"%2\")! Verwende text\n"

