dnl Process this file with autoconf to produce a configure script.

AC_REVISION($Revision$)

AC_INIT()

MAJOR_VERSION=0
MINOR_VERSION=2
MICRO_VERSION=03
RELEASE=$MAJOR_VERSION.$MINOR_VERSION
VERSION=$RELEASE.$MICRO_VERSION
AC_DEFINE_UNQUOTED(MICRO_VERSION, "$MICRO_VERSION")
AC_SUBST(VERSION)
AC_SUBST(RELEASE)

dnl AC_CANONICAL_SYSTEM

AC_LANG_C
AC_LANG_CPLUSPLUS

AC_C_BIGENDIAN

AM_INIT_AUTOMAKE(IExtract, $VERSION)
dnl AM_CONFIG_HEADER(config.h)

AC_PROG_CXX
AC_LANG_CPLUSPLUS
AC_PROG_LIBTOOL
AC_PROG_INSTALL
AC_PROG_MAKE_SET

dnl Checks for programs.

dnl Checks for libraries.
AC_CHECK_LIB(stdc++, main)
AC_CHECK_LIB(gmp, main)
AC_CHECK_LIB(Attr, main)

dnl Checks for header files.

dnl Checks for typedefs, structures, and compiler characteristics.

dnl Checks for library functions.

dnl Enable special features
dnl Enable special features
AC_ARG_ENABLE(debug,
              AC_HELP_STRING([[[[[--enable-debug[=LEVEL]]]]]],
                             [Enables additional traces (LEVEL=0..9)]),
              if test "$enableval" != "no"; then
                  test "$enableval" == "yes" && enableval=0
                  CXXFLAGS="-g -O2 -DTRACELEVEL=$enableval";
              else
                  CXXFLAGS="-O2 -UTRACELEVEL"; fi)
AC_ARG_ENABLE(checks,
              AC_HELP_STRING([[[[[--enable-checks[=LEVEL]]]]]],
                             [Enables additional (internal) checks (LEVEL=0..9)]),
              if test "$enableval" != "no"; then
                  test "$enableval" == "yes" && enableval=0
                  CXXFLAGS="$CXXFLAGS -DCHECK=$enableval";
              else
                  CXXFLAGS="$CXXFLAGS -DNDEBUG -UCHECK"; fi)
AC_ARG_ENABLE(threads,
              [AC_HELP_STRING([--enable-threads],
                              [Enables threads for parsing])]
              ,,
              [enable_threads=no])

if test "$enable_threads" == "yes"; then
    CXXFLAGS="$CXXFLAGS -DENABLE_THREADS"; GTKLIBS="-lgthread $GTKLIBS"
fi


AC_OUTPUT([Makefile src/Makefile])
